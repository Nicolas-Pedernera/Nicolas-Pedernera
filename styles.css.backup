:root{
  --bg:#0A0D12;
  --bg-soft:#10141B;
  --panel:#12161E;
  --line:#232A36;
  --ink:#ECEFF4;
  --muted:#8B93A1;
  --accent:#C9A15A;
  --accent-soft:#3A3323;
  --teal:#4C9C93;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;font-size:16px;line-height:1.65}
a{color:inherit;text-decoration:none}
h1,h2,h3{font-family:"Space Grotesk",Inter,sans-serif;font-weight:600;letter-spacing:-.01em;margin:0}
img{max-width:100%;display:block}
.tag-icon{width:14px;height:14px;flex:none}
.btn-icon{width:18px;height:18px}
.contact-icon{width:20px;height:20px;color:var(--accent);margin-bottom:14px}

/* nav */
.nav{height:84px;position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:0 6%;background:rgba(10,13,18,.86);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.brand{font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:18px}
.nav nav{display:flex;gap:38px;font-size:15px}
.nav nav a{color:var(--muted);transition:color .2s}
.nav nav a:hover,.nav nav .active{color:var(--ink)}
.icon-btn{width:44px;height:44px;border:1px solid var(--line);border-radius:10px;display:grid;place-items:center;color:var(--ink);transition:border-color .2s,color .2s}
.icon-btn:hover{border-color:var(--accent);color:var(--accent)}

.section{max-width:1280px;margin:auto;padding:120px 6%}
.kicker{font-size:15px;color:var(--accent);margin:0 0 18px;font-weight:500}

/* hero */
.hero{min-height:auto;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:70px;padding-top:90px}
.hero h1{font-size:58px;line-height:1.08;letter-spacing:-.02em}
.hero h1 span{color:var(--accent)}
.hero .lede{max-width:520px;color:var(--muted);font-size:18px;margin:28px 0 0}
.hero .lede a{color:var(--ink);border-bottom:1px solid var(--accent)}
.actions{display:flex;gap:16px;margin-top:38px;flex-wrap:wrap}
.btn{padding:15px 28px;border:1px solid var(--line);border-radius:10px;font-size:15px;font-weight:500;background:var(--panel);transition:.2s}
.btn:hover{border-color:var(--accent);transform:translateY(-1px)}
.btn.primary{border-color:var(--accent);background:var(--accent);color:#181203;font-weight:600}
.btn.primary:hover{background:#d9ae63}

/* id card */
.id-card{background:linear-gradient(175deg,var(--panel),#0d1016);border:1px solid var(--line);border-radius:22px;padding:14px;max-width:400px;margin-left:auto;box-shadow:0 40px 80px -30px rgba(0,0,0,.6)}
.id-photo{width:100%;aspect-ratio:4/5;border-radius:16px;overflow:hidden;background:#000}
.id-photo img{width:100%;height:100%;object-fit:cover;object-position:top center}
.id-body{padding:26px 14px 16px}
.id-label{display:inline-block;font-size:12px;color:var(--accent);border:1px solid var(--accent-soft);background:var(--accent-soft);padding:4px 10px;border-radius:99px;margin-bottom:14px}
.id-body h2{font-size:24px;margin-bottom:4px}
.id-body>p{color:var(--muted);margin:0 0 20px;font-size:14px}
.id-row{display:flex;justify-content:space-between;font-size:13px;padding:11px 0;border-top:1px solid var(--line)}
.id-row span{color:var(--muted)}

/* about */
.about{display:grid;grid-template-columns:.62fr 1.38fr;gap:64px;align-items:start;border-top:1px solid var(--line)}
.about-photo{border-radius:18px;overflow:hidden;position:sticky;top:120px;aspect-ratio:3/4}
.about-photo img{width:100%;height:100%;object-fit:cover}
.about-text h2{font-size:36px;max-width:11ch;margin-bottom:22px}
.about-text>p{color:var(--muted);font-size:16px;max-width:64ch;margin:0 0 16px}
.about-facts{list-style:none;padding:0;margin:38px 0 0;display:grid;grid-template-columns:repeat(2,1fr);gap:26px 40px}
.about-facts b{display:block;font-family:"Space Grotesk",sans-serif;font-size:17px;margin-bottom:4px}
.about-facts span{color:var(--muted);font-size:13px}

/* stack */
.stack{border-top:1px solid var(--line)}
.stack h2{font-size:36px;margin-bottom:48px}
.stack-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:16px;overflow:hidden}
.stack-grid article{background:var(--bg);padding:36px}
.stack-grid h3{font-size:19px;margin-bottom:10px}
.stack-grid p{color:var(--muted);font-size:14px;max-width:46ch;margin:0 0 22px}
.tags{display:flex;gap:10px;flex-wrap:wrap}
.tags span{display:inline-flex;align-items:center;gap:7px;padding:8px 13px;border:1px solid var(--line);border-radius:8px;font-size:13px;color:var(--ink);background:var(--panel)}

/* projects */
.projects{border-top:1px solid var(--line)}
.projects h2{font-size:36px;margin-bottom:48px}
.project-list{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.project{padding:32px;border:1px solid var(--line);border-radius:16px;background:var(--panel);transition:.25s}
.project:hover{border-color:var(--accent-soft);transform:translateY(-3px)}
.project-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:12px}
.project-head h3{font-size:19px}
.project-head a{font-size:13px;color:var(--accent);white-space:nowrap}
.project>p{color:var(--muted);font-size:14px;margin:0 0 20px;max-width:52ch}
.text-link{display:block;width:max-content;margin:34px auto 0;color:var(--accent);font-size:14px;border-bottom:1px solid var(--accent-soft)}

/* contact */
.contact{text-align:left;border-top:1px solid var(--line)}
.contact h2{font-size:36px;margin-bottom:16px}
.contact>.lede{color:var(--muted);font-size:17px;max-width:56ch;margin:0 0 50px}
.contact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.contact-grid a{border:1px solid var(--line);background:var(--panel);border-radius:14px;padding:26px 22px;transition:.2s}
.contact-grid a:hover{border-color:var(--accent-soft);transform:translateY(-2px)}
.contact-grid span{display:block;font-size:12px;color:var(--muted);margin-bottom:8px}
.contact-grid b{display:block;font-size:14px;word-break:break-word}

footer{display:flex;justify-content:space-between;border-top:1px solid var(--line);color:var(--muted);padding:32px 6%;font-size:13px}

@media(max-width:980px){
  .hero{grid-template-columns:1fr;gap:50px}
  .id-card{margin:0 auto;max-width:340px}
  .about{grid-template-columns:1fr}
  .about-photo{position:static;max-width:320px;aspect-ratio:4/5}
  .stack-grid{grid-template-columns:1fr}
  .project-list{grid-template-columns:1fr}
  .contact-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:640px){
  .nav nav{display:none}
  .hero h1{font-size:42px}
  .about-facts{grid-template-columns:1fr}
  .contact-grid{grid-template-columns:1fr}
  .section{padding:80px 6%}
  footer{flex-direction:column;gap:8px}
}
